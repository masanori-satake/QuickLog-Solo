{
  "name": "quicklog-solo",
  "version": "1.20.0",
  "description": "「1秒で記録、1秒で集計、1秒で安心」をコンセプトにした、ミニマリスト向けサイドパネル作業メモツールです。",
  "main": "projects/app/js/app.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.css\"",
    "format": "prettier --write shared/css/variables.css shared/js/utils/storage.js eslint.config.js shared/js/utils.js shared/js/schema.js shared/js/i18n.js",
    "test": "python3 scripts/generate_animation_registry.py && python3 scripts/verify_animations.py && node --experimental-vm-modules ./node_modules/.bin/jest",
    "test:e2e": "python3 scripts/generate_animation_registry.py && playwright test",
    "test:animation-eval": "python3 scripts/generate_animation_registry.py && playwright test tests/animation_evaluation.spec.js",
    "build": "python3 scripts/generate_png_icons.py && python3 scripts/generate_animation_registry.py && python3 scripts/check_version.py && python3 scripts/create_package.py && npm run build:vite",
    "build:vite": "vite build",
    "package": "npm run build && rm -f extension.zip && cd dist && zip -r ../extension.zip .",
    "version:bump": "python3 scripts/bump_version.py",
    "update-guide-images": "node scripts/update_guide_images.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masanori-satake/QuickLog-Solo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/masanori-satake/QuickLog-Solo/issues"
  },
  "homepage": "https://github.com/masanori-satake/QuickLog-Solo#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.58.2",
    "ajv": "^8.18.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "picomatch": "^2.3.2",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.16.0",
    "vite": "^8.0.16",
    "wait-on": "^9.0.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 120
  }
}
